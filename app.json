{
  "expo": {
    "name": "Swap",
    "slug": "swap",
    "version": "1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swap.barter",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Swap uses your approximate location to show items near you. It is never shown to other people.",
        "NSCameraUsageDescription": "Swap needs the camera so you can photograph items.",
        "NSPhotoLibraryUsageDescription": "Swap needs your photos so you can add pictures of items."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.swap.barter",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Swap uses your approximate location to show items near you. It is never shown to other people."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Swap needs your photos so you can add pictures of items.",
          "cameraPermission": "Swap needs the camera so you can photograph items.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#0E0E10"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B7F34A",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "swap",
    "description": "Swap items with people near you."
  }
}
